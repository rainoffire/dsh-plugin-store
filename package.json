{
  "name": "@rainoffire/dsh-plugin-store",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin Store tab for the DSH Plugins page: browses plugins discovered in the GitHub dsh-plugin topic, classified into the community catalog categories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rainoffire/dsh-plugin-store.git"
  },
  "homepage": "https://github.com/rainoffire/dsh-plugin-store#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-store",
    "marketplace",
    "deepseek-harness"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
